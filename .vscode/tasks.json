{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run desktop",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/dev.ps1", "run"],
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Check workspace",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/dev.ps1", "check"],
      "problemMatcher": ["$rustc"]
    }
  ]
}
